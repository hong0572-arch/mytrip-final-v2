rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // [공통 함수] 로그인한 유저인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. 👤 유저 데이터: 본인 정보만 수정 가능, 읽기는 로그인한 누구나
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId;
      
      // 유저 하위 컬렉션 (포인트 내역 등)
      match /{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 2. ✈️ 워크스페이스 (공용 여행 방)
    match /trips/{tripId} {
      allow read, write: if isAuthenticated();
      
      // 가계부 (지출 내역)
      match /expenses/{expenseId} {
        allow read, write: if isAuthenticated();
      }
      // 💬 채팅방 메시지
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 3. 📱 여행자 피드 (✨ 다중 이미지 URL 배열도 이곳에 저장됨)
    match /feeds/{feedId} {
      allow read: if true;  // 누구나 피드 구경 가능
      allow write: if isAuthenticated(); // 글/사진 등록은 로그인한 사람만

      // ✨ 피드 댓글
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }
    // 4. 💌 동행 매칭 (찌르기) 알림함
    match /match_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // 5. 🌟 추천 여행지 (읽기 전용)
    match /rectrips/{document=**} {
      allow read: if true;
      allow write: if false; // 관리자(콘솔)에서만 작성 가능
    }

    // 6. 🔗 공유 링크 (AI 일람 공유용)
    // 로그인하지 않은 여행자도 일정 공유를 할 수 있도록 모든 읽기/쓰기를 허용합니다.
    match /shared_links/{docId} {
      allow read, write: if true;
    }
        
  }
}