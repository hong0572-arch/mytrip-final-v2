rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // [공통 함수]
    function isAuthenticated() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    // 관리자 = admins/{uid} 문서가 있는 계정(콘솔에서만 만든다). 관리자 화면(/admin)도 같은 기준을 쓴다.
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(uid()));
    }
    // 바뀐 필드가 keys 안에만 있는지
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 0. 🔑 관리자 명단: 본인 문서만 읽기(관리자 화면 확인용), 쓰기는 콘솔에서만
    match /admins/{userId} {
      allow read: if isAuthenticated() && uid() == userId;
      allow write: if false;
    }

    // 1. 👤 유저 데이터: 본인 정보만 수정 가능. 읽기는 본인·관리자만(보호자·동행은 초대 링크로 연결하므로 다른 회원을 찾을 일이 없다)
    // 포인트·출석·퀴즈 기록은 서버(/api/points)만 바꾼다. 가입할 때만 기본 1000P로 만들 수 있다. 탈퇴는 서버(/api/account/delete).
    match /users/{userId} {
      function protectedFields() {
        return ['points', 'lastCheckInDate', 'lastFeedRewardDate', 'quizStats', 'currentAsset'];
      }
      allow read: if (isAuthenticated() && uid() == userId) || isAdmin();
      allow create: if (isAuthenticated() && uid() == userId
          && request.resource.data.get('points', 1000) == 1000
          && request.resource.data.get('currentAsset', 0) == 0)
        || isAdmin();
      allow update: if (isAuthenticated() && uid() == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields()))
        || isAdmin();
      allow delete: if isAdmin();

      // 유저 하위 컬렉션 (포인트 내역 등) — {sub}를 둬서 회원 문서 자체에는 걸리지 않게 한다
      match /{sub}/{document=**} {
        allow read, write: if (isAuthenticated() && uid() == userId) || isAdmin();
      }
    }
    // 관리자 화면의 전체 일정 보기(collectionGroup 'itineraries')
    match /{path=**}/itineraries/{itineraryId} {
      allow read, delete: if isAdmin();
    }

    // 2. ✈️ 여행(워크스페이스): 멤버(memberIds)만 수정·목록 조회
    match /trips/{tripId} {
      function members(data) {
        return data.get('memberIds', []);
      }
      function isMemberOf(data) {
        return isAuthenticated() && uid() in members(data);
      }
      // 초대 링크(/join/<id>)로 처음 들어온 사람이 자기 자신만 멤버로 추가
      function isJoiningSelf() {
        return isAuthenticated()
          && !isMemberOf(resource.data)
          && onlyChanges(['memberIds', 'membersInfo'])
          && members(request.resource.data).toSet() == members(resource.data).toSet().union([uid()].toSet());
      }
      // 동행이 자기 자신만 빼고 나가기
      function isLeavingSelf() {
        return isMemberOf(resource.data)
          && onlyChanges(['memberIds', 'membersInfo'])
          && members(request.resource.data).toSet() == members(resource.data).toSet().difference([uid()].toSet());
      }

      // 단건 조회: 초대·공유 링크(추측할 수 없는 id)를 받은 로그인 사용자. 목록 조회: 내가 속한 여행만.
      allow get: if isAuthenticated();
      allow list: if isMemberOf(resource.data) || isAdmin();
      allow create: if (isMemberOf(request.resource.data)
          && request.resource.data.get('hostId', uid()) == uid())
        || isAdmin();
      // 멤버는 내용을 고칠 수 있지만 만든 사람(hostId)은 바꿀 수 없고 자신도 멤버로 남아야 한다.
      allow update: if (isMemberOf(resource.data)
          && isMemberOf(request.resource.data)
          && request.resource.data.get('hostId', null) == resource.data.get('hostId', null))
        || isLeavingSelf()
        || isJoiningSelf()
        || isAdmin();
      // 삭제: 만든 사람, 또는 혼자 남은 멤버(예전 일정은 hostId가 없을 수 있다)
      allow delete: if (isMemberOf(resource.data)
          && (resource.data.get('hostId', null) == uid() || members(resource.data).size() <= 1))
        || isAdmin();

      function isTripMember() {
        return isAuthenticated()
          && uid() in get(/databases/$(database)/documents/trips/$(tripId)).data.get('memberIds', []);
      }
      // 가계부 (지출 내역)
      match /expenses/{expenseId} {
        allow read, write: if isTripMember() || isAdmin();
      }
      // 💬 채팅방 메시지(안전모드 시스템 알림도 멤버 기기에서 쓴다)
      match /messages/{messageId} {
        allow read, create: if isTripMember() || isAdmin();
        allow update, delete: if (isTripMember() && resource.data.get('senderId', null) == uid()) || isAdmin();
      }
    }

    // 3. 📱 여행자 피드 (✨ 다중 이미지 URL 배열도 이곳에 저장됨)
    match /feeds/{feedId} {
      allow read: if true;  // 누구나 피드 구경 가능
      allow create: if isAuthenticated() && request.resource.data.authorUid == uid();
      // 작성자는 수정, 다른 사람은 좋아요·댓글 수·가져가기 수만 바꿀 수 있다
      allow update: if isAuthenticated()
        && (resource.data.get('authorUid', null) == uid()
          || onlyChanges(['likes', 'likedBy', 'forks', 'comments', 'commentCount']));
      allow delete: if (isAuthenticated() && resource.data.get('authorUid', null) == uid()) || isAdmin();

      // ✨ 피드 댓글
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.uid == uid();
        allow update, delete: if (isAuthenticated() && resource.data.get('uid', null) == uid()) || isAdmin();
      }
    }

    // 4. 💌 동행 초대·정산 요청·안전모드 알림함: 보낸 사람과 받는 사람만
    match /match_requests/{requestId} {
      function isParty(data) {
        return isAuthenticated() && (data.get('senderId', null) == uid() || data.get('targetMateId', null) == uid());
      }
      allow read: if isParty(resource.data) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.senderId == uid();
      // 상태(수락 등)는 당사자가 바꾸되 보낸 사람·받는 사람은 바꿀 수 없다
      allow update: if isParty(resource.data)
        && request.resource.data.get('senderId', null) == resource.data.get('senderId', null)
        && request.resource.data.get('targetMateId', null) == resource.data.get('targetMateId', null);
      allow delete: if isParty(resource.data) || isAdmin();
    }

    // 5. 🌟 추천 여행지 (읽기 전용)
    match /rectrips/{document=**} {
      allow read: if true;
      allow write: if isAdmin(); // 관리자 화면에서만
    }

    // 6. 🔗 공유 링크 (AI 일정 공유용)
    // 로그인하지 않은 여행자도 링크를 만들 수 있다. 한번 만든 링크는 아무도 고치거나 지울 수 없다.
    match /shared_links/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    // 7. 🛡️ 안심 귀가 실시간 세션 (Safe Mode)
    // 위치·보호자 연락처가 담기므로 본인과 지정된 보호자(앱 회원)만 읽는다.
    // 회원이 아닌 보호자는 서버 API(/api/safemode/live)가 일회용 키를 확인해 필요한 항목만 보여준다.
    // 보호자는 여러 명(guardianUserIds)일 수 있다. guardianUserId는 예전 화면 호환용.
    match /safemode_sessions/{userId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == userId
          || resource.data.get('guardianUserId', null) == request.auth.uid
          || request.auth.uid in resource.data.get('guardianUserIds', []));
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 7-1. 🛡️ 안심 귀가 보호자 초대(문서 id = 추측할 수 없는 128비트 키)
    // 링크를 받은 로그인 사용자는 단건 조회·수락(자기 자신만)할 수 있고, 목록은 초대한 사람·수락한 사람만 본다.
    match /guardian_invites/{inviteId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated()
        && (resource.data.ownerUid == uid() || resource.data.get('acceptedBy', null) == uid());
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.status == 'pending'
        && !('acceptedBy' in request.resource.data);
      allow update: if isAuthenticated()
        && resource.data.status == 'pending'
        && resource.data.ownerUid != uid()
        && onlyChanges(['status', 'acceptedBy', 'acceptedName', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == uid();
      allow delete: if isAuthenticated()
        && (resource.data.ownerUid == uid() || resource.data.get('acceptedBy', null) == uid());
    }

    // 8. ✈️ 항공 최저가 캐시 데이터
    match /flight_deals_cache/{docId} {
      allow read: if true;  // 비로그인 상태의 읽기 요청도 에러 없이 허용 (Permission Error 방지)
      allow write: if isAuthenticated(); // 쓰기는 로그인한 회원만 가능
    }

    // 9. 🛍️ 파트너 상품 및 문의 (Partner Products & Inquiries)
    match /products/{productId} {
      allow read: if true; // 누구나 상품 조회 가능
      allow write: if isAuthenticated(); // 일단 로그인한 유저(파트너/어드민) 작성 가능
    }
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // 문의 작성은 로그인 필요
    }
  }
}
