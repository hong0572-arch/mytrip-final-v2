[debug] [2026-02-19T15:46:43.657Z] <<< [apiv2][body] POST https://cloudaicompanion.googleapis.com/v1beta/projects/my-trip-pro/locations/global/instances/default:completeTask {"output":{"messages":[{"content":"```graphql\nquery listAllTrips @auth(level: PUBLIC, insecureReason: \"This operation is safe to expose to the public\") {\n  trips {\n    id\n    name\n    destination\n    startDate\n    endDate\n    budget\n  }\n}\n\nquery getMyTrips @auth(level: USER, insecureReason: \"This operation is safe to expose to all logged in users.\") {\n  trips(where: {ownerId: {eq_expr: \"auth.uid\"}}) {\n    id\n    name\n    destination\n    startDate\n    endDate\n    owner {\n      displayName\n    }\n  }\n}\n\nmutation createTrip($name: String!, $destination: String!, $startDate: Date!, $endDate: Date!, $budget: Float) @auth(level: USER) {\n  trip_insert(data: {\n    name: $name,\n    destination: $destination,\n    startDate: $startDate,\n    endDate: $endDate,\n    budget: $budget,\n    ownerId_expr: \"auth.uid\",\n    createdAt_expr: \"request.time\"\n  })\n}\n\nmutation updateTripDetails($id: UUID!, $name: String, $destination: String, $startDate: Date, $endDate: Date, $budget: Float) @auth(level: USER) {\n  trip_update(\n    key: {id: $id},\n    data: {\n      name: $name,\n      destination: $destination,\n      startDate: $startDate,\n      endDate: $endDate,\n      budget: $budget\n    },\n    where: {ownerId: {eq_expr: \"auth.uid\"}}\n  )\n}\n```","author":"model"}]},"outputDataContext":{"additionalContext":{"@type":"type.googleapis.com/google.cloud.cloudaicompanion.v1main.ChatOutputDataContext","relatedContent":{}}},"attributionContext":{"citationMetadata":{}}}
